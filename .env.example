# Monad Testnet Configuration
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# ERC-8004 Pre-deployed Registry Addresses on Monad Testnet
IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713

# Deployed Negotiation Contract (Populated after running npm run deploy)
NEGOTIATION_CONTRACT_ADDRESS=

# Agent Wallets (Hex Private Keys without or with 0x prefix)
# Note: Two distinct wallets are required to respect ERC-8004 anti-self-feedback rules
BUYER_PRIVATE_KEY=0x...
SELLER_PRIVATE_KEY=0x...

# Alibaba Cloud / DashScope Qwen Configuration
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
